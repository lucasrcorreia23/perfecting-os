# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard > Settings > API). Nunca commite o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# ---------------------------------------------------------------------------
# Módulo Marketing — API pública consumida pelo site externo (app/api/publico/*)
# ---------------------------------------------------------------------------

# Chave service role do Supabase. Ignora RLS: NUNCA prefixe com NEXT_PUBLIC_
# e nunca use fora de src/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Token secreto do site externo (fica só no servidor dele). Concede os GETs
# de posts/funis e o POST de respostas. Gere com: openssl rand -hex 32
MARKETING_API_TOKEN=troque-por-um-token-aleatorio

# Token publicável (pode ir ao bundle do browser do site). Concede APENAS o
# POST de respostas, e só quando a origem estiver na allowlist abaixo.
MARKETING_PUBLIC_TOKEN=troque-por-outro-token-aleatorio

# Origens permitidas no CORS, separadas por vírgula (sem barra no final).
MARKETING_ALLOWED_ORIGINS=https://perfecting.com.br,http://localhost:3001

# Sal do HMAC usado para anonimizar o IP de quem envia o formulário (LGPD).
MARKETING_IP_SALT=troque-por-um-sal-aleatorio

# URL pública do site do blog — usada só para prévias e links dentro do OS.
NEXT_PUBLIC_MARKETING_SITE_URL=https://perfecting.com.br

# ---------------------------------------------------------------------------
# Calculadora de ROI — links públicos tokenizados (app/(calculadora)/*)
# ---------------------------------------------------------------------------

# Segredo do HMAC que deriva o token dos links da calculadora (>= 32 bytes).
# Só o hash do token vai ao banco; com este segredo o servidor rederiva a URL
# para "copiar link". Gere com: openssl rand -hex 32
CALCULATOR_LINK_SECRET=troque-por-um-segredo-aleatorio
